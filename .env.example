# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase (service-role key — server-side only, bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MQTT (HiveMQ Cloud, TLS port 8883)
MQTT_URL=mqtts://your-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your-hivemq-username
MQTT_PASSWORD=your-hivemq-password
MQTT_ENABLED=true

# Device command and alert behavior
DEVICE_ONLINE_WINDOW_MINUTES=5
COMMAND_RATE_LIMIT_MS=10000
FILTER_ALERT_THRESHOLD_LITERS=50
TANK_ALERT_THRESHOLD_ML=500

# Firebase Cloud Messaging (optional — alerts stub to logs when absent)
# FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json

# Mock Raspberry Pi publisher (scripts/mock-rpi.ts)
# DEVICE_ID=known-device-uuid
# MOCK_RPI_INTERVAL_MS=5000
